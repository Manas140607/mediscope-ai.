# MediScope AI — example environment variables.
# Copy this file to `.env` and fill in only what you need.
# All variables are OPTIONAL. The app runs in DEMO MODE without any of them.
# NEVER commit real credentials. Keep secrets server-side only.

# Server-side endpoint that performs real screening-model inference.
# When set, the app attempts live inference and falls back to the
# deterministic demo engine (clearly labelled) on any error.
# Request body: { patient, vitals } — Response body: a ScreeningResult JSON object.
VITE_MODEL_ENDPOINT=

# Endpoint returning a JSON dataset summary (name, source, license,
# recordCount, variables[], labelDistribution[], preprocessing[]).
# When set, the Model & Data page shows real dataset values instead of
# the "not loaded" empty state.
VITE_DATASET_ENDPOINT=

# Supabase (pre-populated for this project; only used if you enable
# remote persistence in patientService.ts).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
